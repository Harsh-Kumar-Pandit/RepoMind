PORT=5000
# Comma-separated list of allowed frontend origins (never "*" when using credentialed auth cookies)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://user:password@host:port/database
# Optional direct PostgreSQL connection URL for running DDL migrations (bypassing connection poolers)
DIRECT_URL=postgresql://user:password@direct-host:port/database

# Optional GitHub Token (increases rate limits)
GITHUB_TOKEN=

# Embedding Provider Selection ("gemini" default, or "openrouter")
EMBEDDING_PROVIDER=gemini

# AI Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_RPM=30
GEMINI_EMBEDDING_BATCH_SIZE=16
INDEXING_BATCH_SIZE=16

# OpenRouter (Chat Fallback & LiquidAI Embeddings)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_CHAT_MODEL=google/gemini-flash-1.5
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
OPENROUTER_EMBEDDING_RPM=60
OPENROUTER_EMBEDDING_BATCH_SIZE=10

# Retrieval
RETRIEVAL_TOP_K=6

# Indexing Limits
INDEXING_MAX_FILES=70
INDEXING_MAX_FILE_SIZE_BYTES=512000
INDEXING_MAX_TOTAL_BYTES=5242880
INDEXING_MAX_CHUNKS=500
INDEXING_MAX_INPUT_TOKENS=200000
INDEXING_MAX_DURATION_MS=300000
INDEXING_LOCK_TTL_MS=120000
INDEXING_LOCK_RENEW_MS=45000
GITHUB_CONCURRENCY=5

# Chunking
CHUNK_TARGET_TOKENS=500
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=60
CHUNK_MIN_TOKENS=30

# Phase 3 — Authentication & Sessions (OAuth + Cookies)
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
SESSION_SECRET=your_session_secret_32_characters_minimum_here
SESSION_COOKIE_NAME=repomind_session
SESSION_TTL_MS=604800000

